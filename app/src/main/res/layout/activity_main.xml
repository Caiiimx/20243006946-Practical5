<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/color_default_background">

    <TextView
        android:id="@+id/textViewTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/main_title"
        android:textColor="@color/color_text_dark"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center" />

    <ImageView
        android:id="@+id/imageViewMap"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp"
        android:src="@drawable/chinese_municipalities"
        android:scaleType="fitCenter"
        android:contentDescription="@string/cd_china_map" />

    <TextView
        android:id="@+id/textViewInputLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/input_label"
        android:textColor="@color/color_text_dark"
        android:textSize="16sp" />

    <EditText
        android:id="@+id/editTextMunicipality"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:hint="@string/input_hint"
        android:inputType="text"
        android:maxLines="1"
        android:imeOptions="actionGo"
        android:textColor="@color/color_text_dark"
        android:autofillHints=""
        android:importantForAutofill="no" />
</LinearLayout>